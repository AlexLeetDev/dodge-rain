# Normalize line endings across platforms
* text=auto

# Enforce LF in the repo for source/text files
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.svg  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Keep CRLF for Windows PowerShell scripts (if you add any)
*.ps1  text eol=crlf

# Treat binary assets as binary (no diff/CRLF transforms)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.mp3  binary
*.wav  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary

# GitHub Linguist: don’t skew language stats with docs/screenshots
docs/**                 linguist-documentation
assets/screenshots/**   linguist-documentation

# When creating release archives, exclude editor config
.vscode/** export-ignore
